<%= render @status_page %>

<div>
  <% if policy(@status_page).edit? %>
    <%= link_to "Edit this status_page", edit_status_page_path(@status_page) %> |
  <% end %>
  <%= link_to "Back to status_pages", status_pages_path %>

  <% if policy(@status_page).destroy? %>
    <%= button_to "Destroy this status_page", @status_page, method: :delete %>
  <% end %>
</div>
